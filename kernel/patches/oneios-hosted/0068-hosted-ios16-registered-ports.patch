+#if XNU_HOSTED
+	/*
+	 * OneiOS hosted (0068): an iOS 16.5 userland sends mach_ports_register/lookup (3403, 3404) with the registered
+	 * ports in one OOL descriptor; iOS 27's sends the same ids in task.defs' 3-port form, which stays the default.
+	 * oneios-legacy-registered-ports=1 answers those two ids with hosted_task_ios16.defs' stubs instead. (Read
+	 * here, not as a TUNABLE: a TUNABLE's name in this file conflicts with mig_e's __startup_const section.)
+	 */
+	uint32_t hosted_legacy_registered_ports = 0;
+	(void)PE_parse_boot_argn("oneios-legacy-registered-ports", &hosted_legacy_registered_ports,
+	    sizeof(hosted_legacy_registered_ports));
+	if (hosted_legacy_registered_ports) {
+		const struct mig_kern_subsystem *ios16 = (const struct mig_kern_subsystem *)&hosted_task_ios16_subsystem;
+		for (j = 0; j < ios16->end - ios16->start; j++) {
+			if (!ios16->kroutine[j].kstub_routine) {
+				continue;
+			}
+			nentry = j + ios16->start;
+			for (pos = 0; pos < MAX_MIG_ENTRIES; pos++) {
+				if (mig_buckets[pos].num == nentry) {
+					break;
+				}
+			}
+			if (pos == MAX_MIG_ENTRIES) {
+				panic("hosted: mig id %d of the iOS 16 registered ports is not in the table", nentry);
+			}
+			assert3u(ios16->kroutine[j].reply_descr_count, <=, IPC_KOBJECT_RDESC_MAX);
+			mig_buckets[pos].kroutine = ios16->kroutine[j].kstub_routine;
+			mig_buckets[pos].kreply_size = ios16->kroutine[j].max_reply_msg;
+			mig_buckets[pos].kreply_desc_cnt = ios16->kroutine[j].reply_descr_count;
+		}
+		printf("hosted: mig ids %d-%d answer in the iOS 16 registered-ports form (oneios-legacy-registered-ports=1)\n",
+		    ios16->start + 3, ios16->end - 1);
+	}
+#endif
+
 	printf("mig_table_max_displ = %d mach_kobj_count = %d\n",
 	    mig_table_max_displ, mach_kobj_count);
 }
