--- /dev/null
+++ b/osfmk/mach/hosted_task_ios16.defs
@@ -0,0 +1,35 @@
+/*
+ * OneiOS hosted (0068): the iOS 16.5 form of the task subsystem's registered-port routines. 16.5's userland
+ * (libsyscall's LIBSYSCALL_INTERFACE stubs) carries the ports in one out-of-line descriptor; iOS 27's sends the
+ * same message ids (3403, 3404) with three port descriptors (_kernelrpc_mach_ports_register3/lookup3, the
+ * kernel's own server form in task.defs, which this file leaves alone). Only one form can answer an id, so the
+ * kernel serves this one in place of task.defs' for those two ids only when the boot asks for it
+ * (oneios-legacy-registered-ports=1, osfmk/kern/ipc_kobject.c's mig_init): a 16.5 image's xnuhost.conf
+ * (userland/roottweak). Without it, iOS 27's launchd gets the reply its stub expects.
+ */
+subsystem
+#if	KERNEL_SERVER || KOBJECT_SERVER
+	KernelServer
+#endif	/* KERNEL_SERVER || KOBJECT_SERVER */
+	  hosted_task_ios16 3400;
+
+#include <mach/std_types.defs>
+#include <mach/mach_types.defs>
+
+/* 3400 task_create, 3401 task_terminate, 3402 task_threads: task.defs' */
+skip;
+skip;
+skip;
+
+/* 3403 */
+routine	mach_ports_register(
+		target_task	: task_t;
+		init_port_set	: mach_port_array_t =
+					^array[] of mach_port_t);
+
+/* 3404 */
+routine	mach_ports_lookup(
+		target_task	: task_t;
+	out	init_port_set	: mach_port_array_t =
+					^array[] of mach_port_t);
+
