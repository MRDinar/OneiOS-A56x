diff --git a/osfmk/arm64/hosted/hosted_machine.c b/osfmk/arm64/hosted/hosted_machine.c
index 92ce253..ef5593d 100644
--- a/osfmk/arm64/hosted/hosted_machine.c
+++ b/osfmk/arm64/hosted/hosted_machine.c
@@ -885,4 +885,133 @@ hosted_user_pac_off(void)
 	}
 	return off != 0;
 }
+
+/* ---- 0081: interrupts and IPIs by host call (fix-mach-rpc, 2026-11-15) --------------------------- */
+/*
+ * ArmCpu, the board's interrupt controller driver, sends an IPI as a store to GICD_ISPENDR and takes each interrupt with
+ * ICC_IAR1_EL1, a store to GICD_ICPENDR (an IPI), ICC_EOIR1_EL1 and ICC_IAR1_EL1 again. Under xnuhost every one of them
+ * is a trapped instruction: a signal on the vCPU's thread, its emulation and the signal return. A Mach RPC between two
+ * processes wakes the server's idle vCPU with an IPI and the client's with another: ten signals a round trip, and three
+ * for every timer interrupt. Here the IPI is the `ipi` host call, and the timer and IPIs are taken with `irq_take` and
+ * `irq_eoi` (function calls); a device's interrupt (irq_take says XH_INTID_UNTAKEN) still goes to ArmCpu's handler,
+ * which takes it as before. Boot argument oneios-fast-irq=0: ArmCpu's way for everything (the old path, to compare).
+ *
+ * The counters (per vCPU, summed by the oneios-perf report in hosted_user.c) and the stamps the report's wake line
+ * reads: when an IPI was last sent to a CPU, and when that CPU last took an interrupt.
+ */
+extern void cpu_signal_handler(void);
+extern void rtclock_intr(unsigned int is_user_context);
+
+struct hosted_irq_counts hosted_irq_cpu[HOSTED_IRQ_CPUS] __attribute__((aligned(128)));
+uint64_t hosted_ipi_sent_at[HOSTED_IRQ_CPUS], hosted_irq_taken_at[HOSTED_IRQ_CPUS];
+
+/*
+ * oneios-fast-irq: 1 (the default) host calls, 0 ArmCpu's way, 2 the two in turn, one oneios-perf period each (an A/B
+ * test in one boot, under the same load: the report says which path each period had). Any mix is safe: ArmCpu takes
+ * SGI 0 as an IPI, and irq_take takes ArmCpu's IPI SPIs. -1 until the first use (the boot argument, the host's vector).
+ */
+static int hosted_fast_irq = -1;
+static volatile uint32_t hosted_fast_irq_turn = 1;     /* mode 2: this period's path */
+
+static bool
+hosted_fast_irq_on(void)
+{
+	if (__improbable(hosted_fast_irq < 0)) {
+		uint32_t wanted = 1;
+		(void)PE_parse_boot_argn("oneios-fast-irq", &wanted, sizeof(wanted));
+		hosted_fast_irq = !HOSTED_HAS(irq_take) ? 0 : wanted > 2 ? 1 : (int)wanted;
+	}
+	return hosted_fast_irq == 2 ? hosted_fast_irq_turn != 0 : hosted_fast_irq != 0;
+}
+
+/* The report, at the end of each period: mode 2 changes path for the next one. */
+void
+hosted_fast_irq_period(void)
+{
+	if (hosted_fast_irq == 2) {
+		hosted_fast_irq_turn ^= 1;
+	}
+}
+
+unsigned
+hosted_fast_irq_mode(void)
+{
+	(void)hosted_fast_irq_on();
+	return (unsigned)hosted_fast_irq;
+}
+
+static inline uint64_t
+hosted_irq_now(void)
+{
+	return mach_absolute_time();          /* the clock of last_made_runnable_time and last_dispatch (the wake line) */
+}
+
+/*
+ * cpu_signal_internal (osfmk/arm/cpu_common.c): send the IPI to the CPU whose physical id (its /cpus reg, xnuhost's
+ * vCPU index) is `phys`. True: sent by host call (SGI 0, which ArmCpu also takes as an IPI). False: the caller sends it
+ * with ArmCpu's PE_cpu_signal. Interrupts are masked there.
+ */
+bool hosted_ipi_send(unsigned int phys);
+bool
+hosted_ipi_send(unsigned int phys)
+{
+	struct hosted_irq_counts *c = &hosted_irq_cpu[(unsigned)cpu_number() & (HOSTED_IRQ_CPUS - 1)];
+	hosted_ipi_sent_at[phys & (HOSTED_IRQ_CPUS - 1)] = hosted_irq_now();
+	if (phys >= 16 || !hosted_fast_irq_on()) {
+		c->ipi_sent_driver++;
+		return false;
+	}
+	c->ipi_sent_hc++;
+	(void)HC(ipi, phys, 0);
+	return true;
+}
+
+/*
+ * sleh_irq (osfmk/arm64/sleh.c) instead of calling the registered handler (ArmCpu::dispatch) directly: the timer and IPIs
+ * by host call, the rest by the driver. Masked, on the interrupt stack.
+ */
+void hosted_irq_dispatch(cpu_data_t *cdp);
+void
+hosted_irq_dispatch(cpu_data_t *cdp)
+{
+	unsigned me = (unsigned)cpu_number() & (HOSTED_IRQ_CPUS - 1);
+	struct hosted_irq_counts *c = &hosted_irq_cpu[me];
+	uint64_t began = hosted_irq_now();
+
+	hosted_irq_taken_at[me] = began;
+	if (hosted_fast_irq_on()) {
+		unsigned taken = 0;
+		for (; taken < 64; taken++) {
+			uint32_t id = (uint32_t)HC(irq_take);
+			if (id == XH_INTID_NONE) {
+				break;
+			}
+			if (id & XH_INTID_UNTAKEN) {
+				goto driver;    /* a device's: ArmCpu takes it (and anything after it) as before */
+			}
+			if (id == XH_INTID_VTIMER) {
+				c->timer_hc++;
+				rtclock_intr(0);
+			} else {
+				c->ipi_hc++;    /* an SGI, or ArmCpu's software-IPI SPI 1008 + n */
+				cpu_signal_handler();
+			}
+			(void)HC(irq_eoi, id);
+		}
+		c->hc_ticks += hosted_irq_now() - began;
+		c->hc_calls++;
+		return;
+	}
+driver:
+	c->driver_calls++;
+	cdp->interrupt_handler(cdp->interrupt_target, cdp->interrupt_refCon, cdp->interrupt_nub, cdp->interrupt_source);
+	c->driver_ticks += hosted_irq_now() - began;
+}
+
+/* For the report: whether the host-call path is on (it is decided at the first interrupt or IPI). */
+unsigned
+hosted_fast_irq_state(void)
+{
+	return hosted_fast_irq_on() ? 1 : 0;
+}
 #endif /* XNU_HOSTED */
