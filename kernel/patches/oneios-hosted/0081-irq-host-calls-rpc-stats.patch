+/* 0081 (fix-mach-rpc): interrupts and IPIs by host call (hosted_machine.c), the Mach RPC round trip and the wake by IPI
+ * (hosted_user.c's report). One block per vCPU. */
+#define HOSTED_IRQ_CPUS 16
+struct hosted_irq_counts {
+	uint64_t timer_hc, ipi_hc;              /* interrupts taken by irq_take, by kind */
+	uint64_t hc_calls, hc_ticks;            /* dispatches that the host calls finished, and their time */
+	uint64_t driver_calls, driver_ticks;    /* dispatches that went to ArmCpu's handler (its trapped registers) */
+	uint64_t ipi_sent_hc, ipi_sent_driver;  /* IPIs sent by the ipi host call, by ArmCpu (a trapped GICD store) */
+	uint64_t wake_ipi_n, wake_to_sent, wake_to_taken, wake_to_run, wake_ipi_t, wake_ipi_max;
+	uint64_t wake_other_n, wake_other_t;
+	uint64_t rpc_n, rpc_t, rpc_max, rpc_b[4];
+	uint64_t sys_same_n, sys_same_t;       /* system calls (bsd, mach) back to their own thread, and their kernel time */
+	uint64_t sys_block_n, sys_block_t;     /* those that blocked: another thread (or idle) came next on the vCPU */
+} __attribute__((aligned(128)));
+extern struct hosted_irq_counts hosted_irq_cpu[HOSTED_IRQ_CPUS];
+extern uint64_t hosted_ipi_sent_at[HOSTED_IRQ_CPUS], hosted_irq_taken_at[HOSTED_IRQ_CPUS];
+extern unsigned hosted_fast_irq_state(void);    /* this moment's path: 1 host calls, 0 ArmCpu */
+extern unsigned hosted_fast_irq_mode(void);     /* oneios-fast-irq: 0, 1, 2 (in turn by period) */
