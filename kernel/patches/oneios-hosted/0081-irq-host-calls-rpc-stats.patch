+/* ---- 0081: the Mach RPC round trip and the wake by IPI (fix-mach-rpc, 2026-11-15) ---------------- */
+/*
+ * A Mach RPC is a mach_msg trap that sends and then receives (mach_msg2_trap -47 or mach_msg_trap -31/-32 with
+ * MACH_SEND_MSG | MACH_RCV_MSG in x1): a synchronous XPC message, a MIG call. Its round trip is the thread's, from the
+ * trap to its next return to user mode (the reply, an error or a timeout), the server's own work included. Counted per
+ * vCPU at the return; the report gives each period's number, mean, maximum and four bands.
+ */
+static inline void
+hosted_rpc_begin(thread_t thread, const arm_saved_state64_t *ss)
+{
+	int32_t number = (int32_t)ss->x[16];
+	if ((number == -47 || number == -31 || number == -32) && (ss->x[1] & 3) == 3) {
+		thread->machine.hosted_rpc_at = hosted_perf_now();
+	}
+}
+
+static inline void
+hosted_rpc_end(thread_t thread)
+{
+	uint64_t ticks = hosted_perf_now() - thread->machine.hosted_rpc_at;
+	struct hosted_irq_counts *c = &hosted_irq_cpu[(unsigned)cpu_number() & (HOSTED_IRQ_CPUS - 1)];
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(ticks, &ns);
+	uint64_t us = ns / 1000;
+	thread->machine.hosted_rpc_at = 0;
+	c->rpc_n++;
+	c->rpc_t += ticks;
+	if (ticks > c->rpc_max) {
+		c->rpc_max = ticks;
+	}
+	c->rpc_b[us < 100 ? 0 : us < 1000 ? 1 : us < 10000 ? 2 : 3]++;
+}
+
+/*
+ * thread_invoke (osfmk/kern/sched_prim.c), as a thread starts to run: `latency` is from it being made runnable to now
+ * (processor->last_dispatch). A thread made runnable before an IPI was sent to this CPU that this CPU took before now was
+ * woken by that IPI: its wait is split into made runnable -> IPI sent (the waker's scheduler), -> interrupt taken (the
+ * host: the vCPU's futex wake or signal and its way out of idle), -> running (the kernel's idle exit and switch).
+ */
+void hosted_perf_wake(uint64_t latency, uint64_t at);
+void
+hosted_perf_wake(uint64_t latency, uint64_t at)
+{
+	unsigned me = (unsigned)cpu_number() & (HOSTED_IRQ_CPUS - 1);
+	struct hosted_irq_counts *c = &hosted_irq_cpu[me];
+	uint64_t runnable = at - latency, sent = hosted_ipi_sent_at[me], taken = hosted_irq_taken_at[me];
+
+	if (hosted_perf_every == 0 || latency > at) {
+		return;
+	}
+	if (sent >= runnable && taken >= sent && at >= taken) {
+		c->wake_ipi_n++;
+		c->wake_to_sent += sent - runnable;
+		c->wake_to_taken += taken - sent;
+		c->wake_to_run += at - taken;
+		c->wake_ipi_t += latency;
+		if (latency > c->wake_ipi_max) {
+			c->wake_ipi_max = latency;
+		}
+	} else {
+		c->wake_other_n++;
+		c->wake_other_t += latency;
+	}
+}
