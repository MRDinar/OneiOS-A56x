+#endif /* XNU_HOSTED */
 	if (rebalance_needed) {
 		return THREAD_NULL;
 	}
@@ -5562,6 +5581,19 @@ sched_edge_thread_avoid_processor(processor_t processor, thread_t thread, ast_t
 		return true;
 	}
 
+#if XNU_HOSTED
+	/*
+	 * 0090: a thread that prefers E and spilled to a P CPU runs on there until it blocks or its quantum ends: no
+	 * preemption to move it back to an E CPU (the two rules below). Its next wake-up places it again by the edges.
+	 */
+	if (hosted_edge_keep_on(processor->processor_set, preferred_pset)) {
+		if (sched_edge_pset_load_metric(preferred_pset, thread->th_sched_bucket) == 0) {
+			os_atomic_inc(&hosted_edge_counts[1], relaxed);
+		}
+		return false;
+	}
+#endif /* XNU_HOSTED */
+
 	/*
 	 * Compaction:
 	 * If the preferred pset for the thread is now idle, try and migrate the thread to that pset.
@@ -5664,6 +5696,19 @@ sched_edge_balance(__unused processor_t idle_processor, processor_set_t idle_pse
 {
 	assert(idle_processor == current_processor());
 	pset_unlock(idle_pset);
+#if XNU_HOSTED
+	/*
+	 * 0090: an E CPU going idle sends no IPI to a P CPU to preempt a spilled thread and take it back. Here that IPI is a
+	 * kick of the iOS thread the P vCPU runs (xnuhost: a signal, 100 us or more against about 1 us on an iPhone), and
+	 * the move puts the thread on a core about half as fast; the thread comes back to E at its next wake-up anyway.
+	 */
+	if (idle_pset->pset_type == PSET_AMP_E && hosted_edge_pullback == 0) {
+		if (sched_edge_foreign_running_thread_available(idle_pset)) {
+			os_atomic_inc(&hosted_edge_counts[0], relaxed);
+		}
+		return false;
+	}
+#endif /* XNU_HOSTED */
 
 	/*
 	 * Iterate over all psets without acquiring pset locks, and racily
@@ -5723,6 +5768,11 @@ sched_edge_balance(__unused processor_t idle_processor, processor_set_t idle_pse
 			/* Finally send the IPI */
 			processor_t ast_processor = processor_array[best_candidate_cpuid];
 			sched_ipi_perform(ast_processor, ipi_type);
+#if XNU_HOSTED
+			if (idle_pset->pset_type == PSET_AMP_E) {
