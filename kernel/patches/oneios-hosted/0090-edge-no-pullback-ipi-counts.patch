diff --git a/osfmk/arm64/hosted/hosted_smp.c b/osfmk/arm64/hosted/hosted_smp.c
--- a/osfmk/arm64/hosted/hosted_smp.c
+++ b/osfmk/arm64/hosted/hosted_smp.c
@@ -326,4 +326,62 @@ hosted_cpu_booted(processor_t processor)
 	thread_deallocate(thread);
 }
 
+/*
+ * 0090 (fix-fps-scheduler-migration, 2026-11-23): no pull-back of a spilled thread from P to E, and the scheduler's
+ * IPIs by reason.
+ *
+ * With 0089 the Edge scheduler's completion step runs, so 0085's E -> P spill works (weight 0 for default and higher)
+ * and so do XNU's own rules that take such a thread back to its preferred E cluster at once: an E CPU going idle sends
+ * a P CPU running a spilled thread a rebalance IPI (sched_edge_balance), and a P CPU preempts its spilled thread when
+ * the E cluster's load is 0 (sched_edge_thread_avoid_processor: "compaction", "running rebalance"). With two E vCPUs
+ * that go idle and busy all the time, threads went back and forth on most dispatches. On the phone (2026-11-23 03:28,
+ * kernel 988c2a7b) xnuhost's `release:` line counted 70,200 iOS threads moved to another vCPU's core in 30 s
+ * (sched_setaffinity each; 14,824 before 0089) against about 131,000 dispatches (the `wake:` and other dispatches),
+ * and its `kick` line 24,419 kicks (931 before): each IPI to a busy vCPU is a signal to the iOS thread it runs (mean
+ * 136 us, p99 3.7 ms), and each move back puts the thread on an A520, about half an A720's speed.
+ *
+ * Here (oneios-edge-pullback=0, the default) a thread that prefers E and runs on a P CPU stays there until it blocks
+ * or its quantum ends: no rebalance IPI from an idle E CPU, which steals by the edges' weights instead (XNU's P -> E
+ * edge, 64 us), and no preemption by the two rules. Its next wake-up places it again (E when E has room). A thread that
+ * prefers P and runs on E is still pulled to an idle P CPU (the UI's threads). oneios-edge-pullback=1 is XNU's way.
+ * The `oneios-perf:   0090:` line every perf period: what was kept, the pull-backs made, and the scheduler's IPIs by
+ * event, to an idle CPU or a busy one.
+ */
+TUNABLE(uint32_t, hosted_edge_pullback, "oneios-edge-pullback", 0);
+/* [0] rebalance IPIs not sent (an idle E CPU found a spilled thread on P), [1] preemptions not made (E's load 0),
+ * [2] rebalance IPIs sent (oneios-edge-pullback=1), [3] unused */
+uint64_t hosted_edge_counts[4];
+/* sched_ipi_action's IPIs by sched_ipi_event_t, [event][0] to an idle CPU, [event][1] to a busy one */
+uint64_t hosted_ipi_events[8][2];
+
+void hosted_edge_report(void);
+
+void
+hosted_edge_report(void)
+{
+	static uint64_t last_counts[4], last_ipis[8][2];
+	uint64_t c[4], d[8][2];
+
+	for (unsigned i = 0; i < 4; i++) {
+		c[i] = os_atomic_load(&hosted_edge_counts[i], relaxed);
+	}
+	for (unsigned e = 0; e < 8; e++) {
+		for (unsigned b = 0; b < 2; b++) {
+			uint64_t now = os_atomic_load(&hosted_ipi_events[e][b], relaxed);
+			d[e][b] = now - last_ipis[e][b];
+			last_ipis[e][b] = now;
+		}
+	}
+	/* sched_ipi_event_t: 1 bound thread, 2 preempt, 3 SMT rebalance, 4 spill, 5 rebalance, 6 realtime preempt */
+	printf("oneios-perf:   0090: spilled threads kept on P: %llu pull-back IPIs not sent, %llu preemptions not made; "
+	    "pull-back IPIs sent %llu (oneios-edge-pullback=%u); scheduler IPIs to idle/busy CPUs: preempt %llu/%llu, "
+	    "spill %llu/%llu, rebalance %llu/%llu, realtime %llu/%llu, bound %llu/%llu, other %llu/%llu\n",
+	    c[0] - last_counts[0], c[1] - last_counts[1], c[2] - last_counts[2], hosted_edge_pullback,
+	    d[2][0], d[2][1], d[4][0], d[4][1], d[5][0], d[5][1], d[6][0], d[6][1], d[1][0], d[1][1],
+	    d[0][0] + d[3][0] + d[7][0], d[0][1] + d[3][1] + d[7][1]);
+	for (unsigned i = 0; i < 4; i++) {
+		last_counts[i] = c[i];
+	}
+}
+
 #endif /* XNU_HOSTED */
