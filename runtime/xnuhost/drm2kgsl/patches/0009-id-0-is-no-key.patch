--- a/src/drm/drm2kgsl/drm2kgsl_renderer.c
+++ b/src/drm/drm2kgsl/drm2kgsl_renderer.c
@@ -1379,6 +1379,11 @@
 static struct kgsl_object *
 kgsl_object_from_res_id(struct kgsl_context *kctx, uint32_t res_id)
 {
+   /* ONEIOS: 0 names no resource, and mesa's hash tables reserve it as their empty key: a search for it asserts
+    * (hash_table.c "!key_pointer_is_reserved") and ends xnuhost. The guest sends it for a BO whose blob the host
+    * refused (GEM_SET_IOVA of res_id 0 on its destroy: boot-jobs 2026-11-23 13:51). */
+   if (!res_id)
+      return NULL;
    struct drm_object *dobj = drm_context_get_object_from_res_id(&kctx->base, res_id);
    return dobj ? to_kgsl_object(dobj) : NULL;
 }
@@ -1386,6 +1391,9 @@
 static struct kgsl_object *
 kgsl_object_from_blob_id(struct kgsl_context *kctx, uint64_t blob_id)
 {
+   /* ONEIOS: 0 is the reserved key too, and drm_context asserts a blob id of more than 32 bits: both are no object. */
+   if (!blob_id || blob_id >> 32)
+      return NULL;
    struct drm_object *dobj =
       drm_context_retrieve_object_from_blob_id(&kctx->base, blob_id);
    return dobj ? to_kgsl_object(dobj) : NULL;
@@ -2168,6 +2176,10 @@
    }
    case DRM_MSM_SUBMITQUEUE_CLOSE: {
       uint32_t id = *(uint32_t *)payload;
+      if (!id) {   /* ONEIOS: KGSL makes no context 0, and 0 is the queue table's reserved key */
+         rsp->ret = -EINVAL;
+         break;
+      }
       kgsl_drawctxt_destroy(kctx, id);
       _mesa_hash_table_remove_key(kctx->sq_to_ring_idx_table,
                                   (void *)(uintptr_t)id);
@@ -2726,8 +2738,8 @@
       }
    }
 
-   const struct hash_entry *entry = _mesa_hash_table_search(
-      kctx->sq_to_ring_idx_table, (void *)(uintptr_t)req->queue_id);
+   const struct hash_entry *entry = !req->queue_id ? NULL :   /* ONEIOS: 0, the reserved key, is no queue */
+      _mesa_hash_table_search(kctx->sq_to_ring_idx_table, (void *)(uintptr_t)req->queue_id);
    if (!entry) {
       drm_err("unknown submitqueue: %u", req->queue_id);
       free(kcmds);
@@ -3243,7 +3255,7 @@
       return 0;
    }
 
-   if (!drm_context_res_id_unused(dctx, res_id)) {
+   if (!res_id || !drm_context_res_id_unused(dctx, res_id)) {   /* ONEIOS: 0, the reserved key, is no res_id */
       drm_err("Invalid res_id %u", res_id);
       return -EINVAL;
    }
