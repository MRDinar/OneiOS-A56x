#!/bin/sh
# codesign for the kernel base's build scripts (macOS and Linux): `oneios-tool ios codesign` (crate oneios-ios,
# codesign.rs, over `ios sign`). The forms they use:
#   codesign --force --sign - --pagesize 4096 --identifier ID [--entitlements PLIST] FILE|BUNDLE
#   codesign --verify --strict FILE|BUNDLE
#   codesign --display --verbose=4 FILE|BUNDLE          (stderr: Identifier=..., CDHash=..., Page size=...)
#   codesign -d --entitlements :- FILE                  (stdout: the signed entitlements)
# A bundle means its CFBundleExecutable; no bundle seal is made. build.sh sets ONEIOS_TOOL (scripts/lib/oneios-tool.sh).
exec "${ONEIOS_TOOL:?codesign shim: ONEIOS_TOOL is not set (userland/metal/build.sh sets it)}" ios codesign "$@"
